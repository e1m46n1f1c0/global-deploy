# =================================================================
# GLOBAL LEADER TRAEFIK CONFIGURATION
# =================================================================
# Rename this file to .env and adjust the ports according to the environment.

# -----------------------------------------------------------------
# ENTORNO Y CERTIFICADOS (LOCAL / PRODUCCIÓN)
# -----------------------------------------------------------------
# Activa perfiles de Docker Compose ('local' levanta step-ca, 'tunnel' levanta Cloudflare)
COMPOSE_PROFILES=tunnel

# Resolver de certificados a usar: 'local-acme' o 'letsencrypt'
CERT_RESOLVER=letsencrypt

# Ports (Local: 8085/4435 | Production: 80/443)
HTTP_PORT=8085
HTTPS_PORT=4435