# =================================================================
# GLOBAL LEADER TRAEFIK & INFRASTRUCTURE CONFIGURATION
# =================================================================
# Duplica este archivo como '.env' y ajusta las variables según tu entorno.

# Puertos de Traefik Global (Local: 8085/4435 | Producción/VPS: 80/443)
HTTP_PORT=80
HTTPS_PORT=443
DASHBOARD_PORT=8080
ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------
# DOMINIO GLOBAL Y ENRUTAMIENTO
# -----------------------------------------------------------------
GLOBAL_DOMAIN=example.com

# Subdominios Globales
OPENOBSERVE_SUBDOMAIN=obs
INFISICAL_SUBDOMAIN=secrets

# Autenticación del Dashboard Global de Traefik (Usuario: admin | Clave: password123)
# ⚠️ IMPORTANTE: Escapar cada '$' duplicándolo como '$$' para Docker Compose
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$QWrwPIM4$$vg0QFR5xt2Z5SWc3lFWOj0

# -----------------------------------------------------------------
# OPENOBSERVE (LOGS & MÉTRICAS)
# -----------------------------------------------------------------
ZO_EMAIL=admin@local.host
ZO_PASSWORD=AdminPassword123!

# -----------------------------------------------------------------
# INFISICAL (GESTOR DE SECRETOS)
# -----------------------------------------------------------------
INFISICAL_DB_USER=infisical
INFISICAL_DB_NAME=infisical
INFISICAL_DB_PASSWORD=change_this_infisical_db_password
INFISICAL_ENCRYPTION_KEY=hex_32_bytes_random_encryption_key_here
INFISICAL_AUTH_SECRET=base64_random_auth_secret_here

# -----------------------------------------------------------------
# CONFIGURACIÓN SMTP (CORREO PARA INVITACIONES Y RECUPERACIÓN)
# -----------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=apikey_or_user
SMTP_PASSWORD=smtp_secret_password_here
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Infisical
# SMTP_SECURE: 'false' para puerto 587 (STARTTLS) o 25; 'true' para puerto 465 (SSL)
SMTP_SECURE=false

# -----------------------------------------------------------------
# CLOUDFLARE ZERO TRUST TUNNEL (OPCIONAL / PRODUCCIÓN)
# -----------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here