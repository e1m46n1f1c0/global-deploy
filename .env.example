# =================================================================
# GLOBAL LEADER TRAEFIK CONFIGURATION
# =================================================================
# Rename this file to .env and adjust the ports according to the environment.

# Ports (Local: 8085/4435 | Production: 80/443)
HTTP_PORT=80
HTTPS_PORT=443

# Traefik Dashboard Port (Local only, avoid in production)
DASHBOARD_PORT=8080

# ACME Email for Let's Encrypt SSL certificates in production
ACME_EMAIL=admin@ideasfarm.com